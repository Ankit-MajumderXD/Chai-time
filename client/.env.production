# Production build config — points the client at SpacetimeDB Maincloud.
#
# Vite loads this only for `vite build` (mode=production); it does not affect
# `npm run dev`, which uses .env.local (127.0.0.1:3000) or the built-in
# localhost defaults. Both values below are public — they ship in the JS
# bundle and are visible on the SpacetimeDB dashboard — so this file is
# committed. Machine-specific overrides go in .env.local (gitignored).
VITE_SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
VITE_SPACETIMEDB_DB_NAME=chai-time-r7mf4

# Media still falls back to data URLs. For real photo/video storage, point this
# at an R2/S3 presigning endpoint that returns { uploadUrl, publicUrl }.
# VITE_MEDIA_UPLOAD_URL=https://media.example.com/presign
