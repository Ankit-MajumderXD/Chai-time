# Copy to .env.local for local development (this file is committed; .env.local is not).
#
# The client also has built-in defaults (ws://127.0.0.1:3000), so for a stock
# local setup you don't strictly need .env.local at all.

VITE_SPACETIMEDB_HOST=ws://127.0.0.1:3000
VITE_SPACETIMEDB_DB_NAME=chai-time-r7mf4

# Optional: an object-storage presigning endpoint that returns { uploadUrl, publicUrl }.
# Without it, media falls back to inline data URLs (fine for local dev).
# VITE_MEDIA_UPLOAD_URL=https://media.example.com/presign
